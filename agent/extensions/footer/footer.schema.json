{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional JSON Schema reference used by editors."
    },
    "layout": {
      "type": "string",
      "enum": [
        "default",
        "minimal",
        "compact",
        "full"
      ],
      "description": "Active layout when a session starts."
    },
    "starship": {
      "type": "object",
      "properties": {
        "enabled": {
          "$ref": "#/$defs/__schema0"
        },
        "command": {
          "$ref": "#/$defs/__schema1"
        },
        "timeoutMs": {
          "$ref": "#/$defs/__schema2"
        },
        "shell": {
          "$ref": "#/$defs/__schema3"
        }
      },
      "additionalProperties": false,
      "description": "Starship command settings."
    },
    "statuses": {
      "type": "object",
      "properties": {
        "keep": {
          "$ref": "#/$defs/__schema4"
        },
        "hide": {
          "$ref": "#/$defs/__schema6"
        }
      },
      "additionalProperties": false,
      "description": "Filters for extension statuses rendered by the `extension-statuses` item."
    },
    "layouts": {
      "type": "object",
      "properties": {
        "default": {
          "$ref": "#/$defs/__schema8"
        },
        "minimal": {
          "$ref": "#/$defs/__schema14"
        },
        "compact": {
          "$ref": "#/$defs/__schema15"
        },
        "full": {
          "$ref": "#/$defs/__schema16"
        }
      },
      "additionalProperties": false,
      "description": "Per-layout row and item overrides."
    }
  },
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "boolean",
      "description": "Enable or disable the Starship item."
    },
    "__schema1": {
      "type": "string",
      "minLength": 1,
      "description": "Command used to invoke Starship."
    },
    "__schema2": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "description": "Maximum time to wait for the Starship process in milliseconds."
    },
    "__schema3": {
      "type": "string",
      "minLength": 1,
      "description": "Value passed as STARSHIP_SHELL."
    },
    "__schema4": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema5"
      },
      "description": "Optional status-key patterns to render. Supports `*` wildcards. When empty or omitted, all statuses are eligible."
    },
    "__schema5": {
      "type": "string",
      "minLength": 1
    },
    "__schema6": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema7"
      },
      "description": "Status-key patterns to hide. Supports `*` wildcards and wins over `keep`."
    },
    "__schema7": {
      "type": "string",
      "minLength": 1
    },
    "__schema8": {
      "$ref": "#/$defs/__schema9"
    },
    "__schema9": {
      "type": "object",
      "properties": {
        "items": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/__schema10"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema11"
          },
          "description": "Per-item overrides keyed by item id."
        },
        "rows": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/__schema12"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema13"
          },
          "description": "Per-row overrides keyed by row id."
        }
      },
      "additionalProperties": false
    },
    "__schema10": {
      "type": "string"
    },
    "__schema11": {
      "default": {},
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable or disable the item for this layout."
        },
        "row": {
          "type": "string",
          "description": "Row id where the item should render."
        },
        "section": {
          "type": "string",
          "enum": [
            "a",
            "b",
            "c",
            "x",
            "y",
            "z"
          ],
          "description": "Footer section for this item."
        },
        "order": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "description": "Sort order within the row section."
        }
      },
      "additionalProperties": false
    },
    "__schema12": {
      "type": "string"
    },
    "__schema13": {
      "default": {},
      "type": "object",
      "properties": {
        "order": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "description": "Row render order; lower numbers render first."
        },
        "itemSeparator": {
          "type": "string",
          "description": "Separator used between items inside the same section."
        },
        "sectionSeparator": {
          "type": "string",
          "description": "Separator used between left-side sections and, by default, right-side sections."
        },
        "rightSectionSeparator": {
          "type": "string",
          "description": "Optional separator used only between right-side sections (`x`, `y`, `z`)."
        }
      },
      "additionalProperties": false
    },
    "__schema14": {
      "$ref": "#/$defs/__schema9"
    },
    "__schema15": {
      "$ref": "#/$defs/__schema9"
    },
    "__schema16": {
      "$ref": "#/$defs/__schema9"
    }
  },
  "$id": "https://pi.local/schemas/footer.schema.json",
  "title": "Pi footer configuration",
  "description": "Configuration for the footer extension."
}
