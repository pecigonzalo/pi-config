{
  "default": {
    // Named preset: plan | workspace-write | full-access
    "mode": "workspace-write",
    "rules": [
      // Allow the global MCP config to be managed from this Pi config workspace.
      // Protected resources are still enabled globally; only this file is unprotected below.
      {
        "tool": "read",
        "match": "^${HOME}/\\.mcp\\.json$",
        "action": "allow",
        "externalPathAction": "allow",
      },
      {
        "tool": "write",
        "match": "^${HOME}/\\.mcp\\.json$",
        "action": "allow",
        "externalPathAction": "allow",
      },
      {
        "tool": "edit",
        "match": "^${HOME}/\\.mcp\\.json$",
        "action": "allow",
        "externalPathAction": "allow",
      },
      // ── Read: protect secrets and credentials ───────────────────────────────
      // Allow Pi's own shipped docs/examples without approving the changing bunx path.
      {
        "tool": "read",
        "match": "^${PI_PACKAGE_DIR}/(README\\.md|CHANGELOG\\.md|docs(/|$)|examples(/|$))",
        "action": "allow",
        "externalPathAction": "allow",
      },
      {
        "tool": "grep",
        "match": "^${PI_PACKAGE_DIR}/(docs(/|$)|examples(/|$))",
        "action": "allow",
        "externalPathAction": "allow",
      },
      {
        "tool": "find",
        "match": "^${PI_PACKAGE_DIR}/(docs(/|$)|examples(/|$))",
        "action": "allow",
        "externalPathAction": "allow",
      },
      {
        "tool": "ls",
        "match": "^${PI_PACKAGE_DIR}(/(docs|examples)(/|$).*)?$",
        "action": "allow",
        "externalPathAction": "allow",
      },
      // Built-in protected resources cover secrets, credentials, and key material.
      // Keep structured tools out of all Git internals, beyond the built-in hooks/config protection.
      {
        "tool": "write",
        "match": "(^|[/])\\.git[/]",
        "action": "block",
        "reason": "Git internals",
      },
      {
        "tool": "edit",
        "match": "(^|[/])\\.git[/]",
        "action": "block",
        "reason": "Git internals",
      },
      // ── Bash: safe read-only and informational commands → allow ─────────────
      // Match supports readable shorthand for bash:
      // - "rg"   => word-boundary match (like /\brg\b/i)
      // - "rg *" => command-prefix match ("rg" or "rg ...")
      {
        "tool": "bash",
        "match": "^set\\s+(?:-euo\\s+pipefail|-o\\s+pipefail)\\s*$",
        "action": "allow",
      },
      {
        "tool": "bash",
        "match": "(^|[;&|()\\s])g?sed\\b[^;&|\\n]*\\s(-[A-Za-z]*i[A-Za-z]*|--in-place(?:=|\\s|$))",
        "action": "ask",
        "reason": "sed in-place edit may modify files",
      },
      {
        "tool": "bash",
        "match": "(^|[;&|()\\s])g?sed\\b[^;&|\\n]*(^|\\s)(?:[0-9]*>>?|&>)\\s*(?!&)",
        "action": "ask",
        "reason": "sed output redirection may write files",
      },
      {
        "tool": "bash",
        "match": "sed *",
        "action": "allow",
      },
      {
        "tool": "bash",
        "match": "gsed *",
        "action": "allow",
      },
      {
        "tool": "bash",
        "match": "^(cd|cat|rg|find|wc|grep|head|uniq|ls|nl|sort|tail|tee|echo|printf|pwd|which|file|diff|stat|du|df|date|uname|env|printenv|type|true|false|test|mktemp|tr|jq|readlink|strings|fd)\\b",
        "action": "allow",
      },
      {
        "tool": "bash",
        "match": "cp *",
        "action": "ask",
        "reason": "Copies files and may overwrite existing content",
      },
      // ── Bash: git — ask before history-rewriting or remote-pushing ops ──────
      {
        "tool": "bash",
        "match": "\\bgit\\s+push\\b",
        "action": "ask",
        "reason": "Pushes to remote",
      },
      {
        "tool": "bash",
        "match": "\\bgit\\s+reset\\s+--hard\\b|\\bgit\\s+(clean|restore|rebase)\\b",
        "action": "ask",
        "reason": "Mutates repo state or rewrites history",
      },
      {
        "tool": "bash",
        "match": "git *",
        "action": "allow",
      },
      // ── Bash: low-risk build / inspection commands → allow ──────────────────
      {
        "tool": "bash",
        "match": "^(gofmt|golangci-lint|govulncheck)\\b",
        "action": "allow",
      },
      // ── Bash: Docker Compose read-only inspection → allow ───────────────────
      // Mutating or code-running subcommands such as up, down, run, exec, build,
      // pull, push, restart, and rm continue to fall through to approval.
      {
        "tool": "bash",
        "match": "^(docker\\s+compose|docker-compose)\\s+(version|ls|ps|images|top|port)(?:\\s+[^;&|<>$`\\n]*)?\\s*$",
        "action": "allow",
      },
      {
        "tool": "bash",
        "match": "^(docker\\s+compose|docker-compose)\\s+logs(?:\\s+[^;&|<>$`\\n]*)?\\s*$",
        "action": "allow",
      },
      {
        "tool": "bash",
        "match": "^(docker\\s+compose|docker-compose)\\s+config\\s+(-q|--quiet)\\s*$",
        "action": "allow",
      },
      // ── Bash: ask for direct code execution / ephemeral executors ────────────
      // sandbox=false still applies normal permission checks, but executes the
      // approved command outside the OS sandbox for GUI/MCP process trees.
      {
        "tool": "bash",
        "match": [
          "bunx @playwright/cli *",
          "bunx @playwright/mcp *",
          "bunx playwright *",
        ],
        "action": "ask",
        "sandbox": false,
        "reason": "Browser automation process trees cannot be usefully sandboxed",
      },
      {
        "tool": "bash",
        "match": "bunx mcporter *",
        "action": "allow",
        "sandbox": false,
        "reason": "mcporter manages MCP transports and daemon state outside the workspace sandbox",
      },
      {
        "tool": "bash",
        "match": "^go\\s+(run|generate)\\b",
        "action": "ask",
        "reason": "Executes Go code or project-defined commands",
      },
      {
        "tool": "bash",
        "match": "^(python3?)\\b",
        "action": "ask",
        "reason": "Executes Python code",
      },
      {
        "tool": "bash",
        "match": "^(npx|bunx|uvx|npm\\s+exec|pnpm\\s+dlx|yarn\\s+dlx)\\b",
        "action": "ask",
        "reason": "Can download and run arbitrary package code",
      },
      // ── Bash: common build / package-manager commands → allow ────────────────
      {
        "tool": "bash",
        "match": "^go\\b",
        "action": "allow",
      },
      {
        "tool": "bash",
        "match": "^(node|npm|bun|yarn|pnpm|corepack)\\b",
        "action": "allow",
      },
      {
        "tool": "bash",
        "match": "^(pip3?|uv|ruff|mypy|pytest|poetry)\\b",
        "action": "allow",
      },
      {
        "tool": "bash",
        "match": "^(cargo|rustc|rustfmt|clippy)\\b",
        "action": "ask",
        "reason": "Rust tooling can build, run code, or rewrite files",
      },
      {
        "tool": "bash",
        "match": "^(make|task|just)\\b",
        "action": "allow",
      },
      {
        "tool": "bash",
        "match": "^(terraform|tofu)\\s+(init|plan|validate|fmt|show|output|state\\s+list)\\b",
        "action": "ask",
        "reason": "Infrastructure tooling may access the network, local state, or rewrite files",
      },
      {
        "tool": "bash",
        "match": "^(terraform|tofu)\\s+(apply|destroy|import|workspace\\s+(new|delete))\\b",
        "action": "ask",
        "reason": "Modifies infrastructure state",
      },
      // ── Bash: ask before destructive or privileged operations ───────────────
      {
        "tool": "bash",
        "match": "rm",
        "action": "ask",
        "reason": "Deletes files",
      },
      {
        "tool": "bash",
        "match": "mv",
        "action": "ask",
        "reason": "Moves or renames",
      },
      {
        "tool": "bash",
        "match": "sudo",
        "action": "ask",
        "reason": "Elevated privileges",
      },
      {
        "tool": "bash",
        "match": "\\b(chmod|chown)\\b",
        "action": "ask",
        "reason": "Changes permissions or ownership",
      },
      {
        "tool": "bash",
        "match": "kill",
        "action": "ask",
        "reason": "Terminates processes",
      },
      {
        "tool": "bash",
        "match": "\\bcurl\\b.+(-X\\s*(POST|PUT|DELETE|PATCH)|--request\\s+(POST|PUT|DELETE|PATCH))",
        "action": "ask",
        "reason": "HTTP write operation",
      },
      // ── Bash: catch-all — ask for anything not explicitly matched ────────────
      // Mirrors opencode's safe default of asking before unknown commands.
      // Add explicit `allow` rules in .pi/permissions.jsonc for project-specific tools.
      {
        "tool": "bash",
        "action": "ask",
      },
    ],
    // Restrict structured filesystem tools (read/write/edit/grep/find/ls) to the current project.
    // Explicit "allow" rules take precedence over this. Bash is not covered here.
    "externalPath": "ask",
    "sessionGuard": {
      "confirmNewSession": true,
      "confirmSwitchSession": true,
      "confirmFork": false,
      "dirtyRepo": "warn",
      "restoreCodeOnFork": "ask",
      "restoreCodeOnTree": "ask",
    },
  },
  "protectedResources": {
    "unprotectWrite": ["(^|[/])\\.mcp\\.json$"],
  },
  "profiles": {
    "read-only": {
      "inherit": true,
      "mode": "plan",
      "rules": [
        {
          "tool": "task",
          "action": "block",
          "reason": "read-only workers do not delegate further",
        },
        {
          "tool": "write",
          "action": "block",
          "reason": "read-only profile",
        },
        {
          "tool": "edit",
          "action": "block",
          "reason": "read-only profile",
        },
        {
          "tool": "bash",
          "action": "block",
          "reason": "read-only profile uses structured read tools only",
        },
      ],
    },
    "isolated": {
      "inherit": false,
      "mode": "plan",
      "rules": [
        {
          "tool": "task",
          "action": "block",
          "reason": "isolated workers do not delegate further",
        },
        {
          "tool": "read",
          "action": "block",
          "reason": "isolated profile",
        },
        {
          "tool": "write",
          "action": "block",
          "reason": "isolated profile",
        },
        {
          "tool": "edit",
          "action": "block",
          "reason": "isolated profile",
        },
        {
          "tool": "grep",
          "action": "block",
          "reason": "isolated profile",
        },
        {
          "tool": "find",
          "action": "block",
          "reason": "isolated profile",
        },
        {
          "tool": "ls",
          "action": "block",
          "reason": "isolated profile",
        },
        {
          "tool": "bash",
          "action": "block",
          "reason": "isolated profile",
        },
      ],
    },
  },
  "agents": {
    "orchestrator": {
      "inherit": true,
      "rules": [
        {
          "tool": "task",
          "action": "allow",
        },
        {
          "tool": "write",
          "action": "block",
          "reason": "Orchestrator should delegate file mutation",
        },
        {
          "tool": "edit",
          "action": "block",
          "reason": "Orchestrator should delegate file mutation",
        },
      ],
    },
  },
  "sandbox": {
    "enabled": true,
    "enableWeakerNetworkIsolation": true,
    "allowSshAuthSock": true,
    "allowLocalBinding": true,
    "addAllowWrite": ["~/.mcporter", "~/.mcp.json"],
  },
}
