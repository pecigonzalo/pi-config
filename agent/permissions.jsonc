{
  "default": {
    // Named preset: plan | workspace-write | full-access
    "mode": "workspace-write",
    "rules": [
      // ── Read: protect secrets and credentials ───────────────────────────────
      // Allow Pi's own shipped docs/examples without approving the changing bunx path.
      {
        "tool": "read",
        "match": "^${PI_PACKAGE_DIR}/(README\\.md|CHANGELOG\\.md|docs(/|$)|examples(/|$))",
        "action": "allow",
        "externalPathAction": "allow",
      },
      {
        "tool": "grep",
        "match": "^${PI_PACKAGE_DIR}/(docs(/|$)|examples(/|$))",
        "action": "allow",
        "externalPathAction": "allow",
      },
      {
        "tool": "find",
        "match": "^${PI_PACKAGE_DIR}/(docs(/|$)|examples(/|$))",
        "action": "allow",
        "externalPathAction": "allow",
      },
      {
        "tool": "ls",
        "match": "^${PI_PACKAGE_DIR}(/(docs|examples)(/|$)?)?$",
        "action": "allow",
        "externalPathAction": "allow",
      },
      // .env.example is safe to read — allow it before the broader .env block
      {
        "tool": "read",
        "match": "\\.env\\.example$",
        "action": "allow",
      },
      // Block .env, .env.local, .env.production, etc.
      {
        "tool": "read",
        "match": "\\.env(\\..+)?$",
        "action": "block",
        "reason": "May contain secrets",
      },
      // Block private keys and certificates
      {
        "tool": "read",
        "match": "\\.(pem|key|p12|pfx|crt|ca-bundle)$",
        "action": "block",
        "reason": "Private key or certificate",
      },
      // Block ~/.aws/credentials, ~/.ssh/*, etc.
      {
        "tool": "read",
        "match": "(^|[/])(\\.aws[/]|\\.ssh[/])",
        "action": "block",
        "reason": "Credentials directory",
      },
      // ── Write / Edit: protect secrets and git internals ─────────────────────
      // Note: enforcing "local repo only" for write/edit requires cwd context
      // which the current rule engine does not have. Add an explicit block for
      // out-of-project absolute paths in a project-local .pi/permissions.json
      // if needed.
      {
        "tool": "write",
        "match": "\\.env\\.example$",
        "action": "allow",
      },
      {
        "tool": "write",
        "match": "\\.env(\\..+)?$",
        "action": "block",
        "reason": "Env file protected",
      },
      {
        "tool": "write",
        "match": "\\.(pem|key|p12|pfx)$",
        "action": "block",
        "reason": "Key file protected",
      },
      {
        "tool": "write",
        "match": "(^|[/])\\.git[/]",
        "action": "block",
        "reason": "Git internals",
      },
      {
        "tool": "edit",
        "match": "\\.env\\.example$",
        "action": "allow",
      },
      {
        "tool": "edit",
        "match": "\\.env(\\..+)?$",
        "action": "block",
        "reason": "Env file protected",
      },
      {
        "tool": "edit",
        "match": "\\.(pem|key|p12|pfx)$",
        "action": "block",
        "reason": "Key file protected",
      },
      {
        "tool": "edit",
        "match": "(^|[/])\\.git[/]",
        "action": "block",
        "reason": "Git internals",
      },
      // ── Bash: safe read-only and informational commands → allow ─────────────
      // Match supports readable shorthand for bash:
      // - "rg"   => word-boundary match (like /\brg\b/i)
      // - "rg *" => command-prefix match ("rg" or "rg ...")
      {
        "tool": "bash",
        "match": "(^|[;&|()\\s])g?sed\\b[^;&|\\n]*\\s(-[A-Za-z]*i[A-Za-z]*|--in-place(?:=|\\s|$))",
        "action": "ask",
        "reason": "sed in-place edit may modify files",
      },
      {
        "tool": "bash",
        "match": "(^|[;&|()\\s])g?sed\\b[^;&|\\n]*(^|\\s)(?:[0-9]*>>?|&>)\\s*(?!&)",
        "action": "ask",
        "reason": "sed output redirection may write files",
      },
      {
        "tool": "bash",
        "match": "sed *",
        "action": "allow",
      },
      {
        "tool": "bash",
        "match": "gsed *",
        "action": "allow",
      },
      {
        "tool": "bash",
        "match": "^(cd|cat|rg|find|wc|grep|head|uniq|ls|sort|tail|tee|echo|printf|pwd|which|file|diff|stat|du|df|date|uname|env|printenv|type|true|false|pwd)\\b",
        "action": "allow",
      },
      {
        "tool": "bash",
        "match": "cp *",
        "action": "ask",
        "reason": "Copies files and may overwrite existing content",
      },
      // ── Bash: git — ask before history-rewriting or remote-pushing ops ──────
      {
        "tool": "bash",
        "match": "\\bgit\\s+push\\b",
        "action": "ask",
        "reason": "Pushes to remote",
      },
      {
        "tool": "bash",
        "match": "\\bgit\\s+reset\\s+--hard\\b|\\bgit\\s+(clean|restore|rebase)\\b",
        "action": "ask",
        "reason": "Mutates repo state or rewrites history",
      },
      {
        "tool": "bash",
        "match": "git *",
        "action": "allow",
      },
      // ── Bash: low-risk build / inspection commands → allow ──────────────────
      {
        "tool": "bash",
        "match": "^(gofmt|golangci-lint|govulncheck)\\b",
        "action": "allow",
      },
      // ── Bash: ask for direct code execution / ephemeral executors ────────────
      {
        "tool": "bash",
        "match": "^go\\s+(run|generate)\\b",
        "action": "ask",
        "reason": "Executes Go code or project-defined commands",
      },
      {
        "tool": "bash",
        "match": "^(python3?)\\b",
        "action": "ask",
        "reason": "Executes Python code",
      },
      {
        "tool": "bash",
        "match": "^(npx|bunx|uvx|npm\\s+exec|pnpm\\s+dlx|yarn\\s+dlx)\\b",
        "action": "ask",
        "reason": "Can download and run arbitrary package code",
      },
      // ── Bash: common build / package-manager commands → allow ────────────────
      {
        "tool": "bash",
        "match": "^go\\b",
        "action": "allow",
      },
      {
        "tool": "bash",
        "match": "^(node|npm|bun|yarn|pnpm|corepack)\\b",
        "action": "allow",
      },
      {
        "tool": "bash",
        "match": "^(pip3?|uv|ruff|mypy|pytest|poetry)\\b",
        "action": "allow",
      },
      {
        "tool": "bash",
        "match": "^(cargo|rustc|rustfmt|clippy)\\b",
        "action": "ask",
        "reason": "Rust tooling can build, run code, or rewrite files",
      },
      {
        "tool": "bash",
        "match": "^(make|task|just)\\b",
        "action": "allow",
      },
      {
        "tool": "bash",
        "match": "^(terraform|tofu)\\s+(init|plan|validate|fmt|show|output|state\\s+list)\\b",
        "action": "ask",
        "reason": "Infrastructure tooling may access the network, local state, or rewrite files",
      },
      {
        "tool": "bash",
        "match": "^(terraform|tofu)\\s+(apply|destroy|import|workspace\\s+(new|delete))\\b",
        "action": "ask",
        "reason": "Modifies infrastructure state",
      },
      // ── Bash: ask before destructive or privileged operations ───────────────
      {
        "tool": "bash",
        "match": "rm",
        "action": "ask",
        "reason": "Deletes files",
      },
      {
        "tool": "bash",
        "match": "mv",
        "action": "ask",
        "reason": "Moves or renames",
      },
      {
        "tool": "bash",
        "match": "sudo",
        "action": "ask",
        "reason": "Elevated privileges",
      },
      {
        "tool": "bash",
        "match": "\\b(chmod|chown)\\b",
        "action": "ask",
        "reason": "Changes permissions or ownership",
      },
      {
        "tool": "bash",
        "match": "kill",
        "action": "ask",
        "reason": "Terminates processes",
      },
      {
        "tool": "bash",
        "match": "\\bcurl\\b.+(-X\\s*(POST|PUT|DELETE|PATCH)|--request\\s+(POST|PUT|DELETE|PATCH))",
        "action": "ask",
        "reason": "HTTP write operation",
      },
      // ── Bash: catch-all — ask for anything not explicitly matched ────────────
      // Mirrors opencode's safe default of asking before unknown commands.
      // Add explicit `allow` rules in .pi/permissions.json for project-specific tools.
      {
        "tool": "bash",
        "action": "ask",
      },
    ],
    // Restrict structured filesystem tools (read/write/edit/grep/find/ls) to the current project.
    // Explicit "allow" rules take precedence over this. Bash is not covered here.
    "externalPath": "ask",
    "sessionGuard": {
      "confirmNewSession": true,
      "confirmSwitchSession": true,
      "confirmFork": false,
      "dirtyRepo": "warn",
      "restoreCodeOnFork": "ask",
      "restoreCodeOnTree": "ask",
    },
  },
  // Scoped approval settings.
  // "approvals": {
  //   "scopeByProject": true,
  //   "scopeByAgent": true,
  //   "maxAgeDays": 30
  // },
  // Built-in protected resources are defaults and are always overridable here.
  // Effective sets are computed as: (built-ins + addDeny*) - unprotect*
  // "protectedResources": {
  //   "enabled": true,
  //   "defaults": true,
  //   "addDenyRead": ["(^|[/])secrets/"],
  //   "addDenyWrite": ["(^|[/])infra/prod/"],
  //   "unprotectRead": ["\\.env(\\..+)?$"],
  //   "unprotectWrite": ["(^|[/])\\.git/(hooks/|config$)"]
  // },
  "profiles": {
    "read-only": {
      "inherit": true,
      "rules": [
        {
          "tool": "task",
          "action": "block",
          "reason": "read-only workers do not delegate further",
        },
        {
          "tool": "write",
          "action": "block",
          "reason": "read-only profile",
        },
        {
          "tool": "edit",
          "action": "block",
          "reason": "read-only profile",
        },
        {
          "tool": "bash",
          "action": "block",
          "reason": "read-only profile uses structured read tools only",
        }
      ]
    },
    "isolated": {
      "inherit": false,
      "rules": [
        {
          "tool": "task",
          "action": "block",
          "reason": "isolated workers do not delegate further",
        },
        {
          "tool": "read",
          "action": "block",
          "reason": "isolated profile",
        },
        {
          "tool": "write",
          "action": "block",
          "reason": "isolated profile",
        },
        {
          "tool": "edit",
          "action": "block",
          "reason": "isolated profile",
        },
        {
          "tool": "grep",
          "action": "block",
          "reason": "isolated profile",
        },
        {
          "tool": "find",
          "action": "block",
          "reason": "isolated profile",
        },
        {
          "tool": "ls",
          "action": "block",
          "reason": "isolated profile",
        },
        {
          "tool": "bash",
          "action": "block",
          "reason": "isolated profile",
        }
      ]
    }
  },
  "agents": {
    "orchestrator": {
      "inherit": true,
      "rules": [
        {
          "tool": "task",
          "action": "allow",
        },
        {
          "tool": "write",
          "action": "block",
          "reason": "Orchestrator should delegate file mutation",
        },
        {
          "tool": "edit",
          "action": "block",
          "reason": "Orchestrator should delegate file mutation",
        }
      ]
    }
  },
  // Optional bash sandbox backend. If the sandbox runtime is installed,
  // workspace-write and plan modes enable it automatically unless disabled.
  //
  // "sandbox": {
  //   "enabled": true,
  //   "network": true,
  //   // Optional sandbox temp dir base (exported as CLAUDE_TMPDIR/TMPDIR)
  //   // Defaults to os.tmpdir()/pi
  //   // "tmpDir": "/tmp/pi",
  //   // Temp dir strategy:
  //   // - "session" (default): creates mkdtemp() session-* dirs under tmpDir
  //   // - "shared": uses tmpDir directly
  //   // "tmpDirMode": "session",
  //   // Include compatibility write paths (/tmp, /private/tmp, os.tmpdir())
  //   // "compatWritePaths": true,
  //   // Optional domain filters (allow-only model).
  //   // If omitted and network=true, network is unrestricted.
  //   // "allowedDomains": ["api.github.com", "*.npmjs.org"],
  //   // "deniedDomains": ["malicious.example.com"],
  //   "allowSshAuthSock": true,
  //   "allowUnixSockets": ["/path/to/ssh-agent.sock"],
  //   "allowAllUnixSockets": false,
  //   "allowWrite": ["/tmp"],
  //   "denyRead": ["~/.ssh", "~/.aws", "~/.gnupg"],
  //   "denyWrite": [".env", ".env.*", "*.pem", "*.key"]
  // }
  "sandbox": {
    "enabled": true,
    "allowSshAuthSock": true,
    // Allow normal workspace writes plus Git index/object updates needed for staging and committing.
    // Sandbox-runtime still blocks sensitive Git internals such as .git/config and .git/hooks/.
    "allowWrite": [".", ".git"],
    "denyRead": ["~/.aws", "~/.gnupg"],
  },
}
