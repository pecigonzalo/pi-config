{
  "mcpServers": {
    "playwright": {
      "command": "bunx",
      "args": [
        "@playwright/mcp@latest",
        "--browser",
        "firefox",
        "--headless",
        "--isolated",
        "--output-dir",
        "${MCPORTER_DAEMON_DIR:-/tmp/.pi-mcporter-daemon}/playwright-output"
      ],
      "lifecycle": "keep-alive"
    },
    "github-grep": {
      "baseUrl": "https://mcp.grep.app"
    },
    "deep-wiki": {
      "baseUrl": "https://mcp.deepwiki.com/mcp"
    }
  },
  "imports": []
}
