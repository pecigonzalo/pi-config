{
  "mcpServers": {
    "playwright": {
      "command": "bunx",
      "args": [
        "--bun",
        "@playwright/mcp@latest",
        "--browser",
        "firefox",
        "--headless",
        "--isolated",
        "--output-dir",
        "~/.pi/mcp-playwright"
      ],
      "description": "Automate browser interactions with Playwright"
    },
    "github-grep": {
      "url": "https://mcp.grep.app",
      "description": "Search code examples on GitHub"
    },
    "deep-wiki": {
      "url": "https://mcp.deepwiki.com/mcp",
      "description": "Search and read developer documentation"
    },
    "linear": {
      "url": "https://mcp.linear.app/mcp",
      "description": "Search and update Linear issues",
      "enabled": false
    },
    "wealthfolio": {
      "type": "http",
      "url": "http://localhost:8080/mcp",
      "headers": {
        "Authorization": "Bearer ${WEALTHFOLIO_API_KEY}"
      },
      "description": "Wealthfolio portfolio data",
      "enabled": false
    }
  }
}
