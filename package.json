{
  "workspaces": [
    "agent/extensions/*"
  ],
  "scripts": {
    "lefthook:install": "lefthook install",
    "test": "bun test --only-failures",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint $(find agent -type f -name '*.ts')",
    "lint:fix": "oxlint --fix $(find agent -type f -name '*.ts')",
    "format:check": "oxfmt --check 'agent/**/*.ts'",
    "format": "oxfmt --write 'agent/**/*.ts'",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test",
    "generate:footer-schema": "cd agent/extensions/footer && bun run generate:footer-schema"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.0.0",
    "@earendil-works/pi-agent-core": "1.0.0",
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@earendil-works/pi-tui": "1.0.0",
    "@types/bun": "^1.3.14",
    "lefthook": "^2.1.6",
    "oxfmt": "0.59.0",
    "oxlint": "1.74.0",
    "typebox": "1.3.7",
    "typescript": "5.9.3"
  }
}
